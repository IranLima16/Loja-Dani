{%- liquid
  assign img = section.settings.image
  assign vid = section.settings.video
-%}

<section class="hero" id="top" data-buybar-trigger style="padding-block:0">
  <div class="hero-grid">
    <div class="hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="display">{{ section.settings.heading }}</h1>
      {%- if section.settings.lede != blank -%}
        <p class="lede">{{ section.settings.lede }}</p>
      {%- endif -%}
      <div class="hero-cta">
        {%- if section.settings.cta1_label != blank -%}
          <a class="btn btn--onInvert" href="{{ section.settings.cta1_url | default: '#edicoes' }}">{{ section.settings.cta1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.cta2_url | default: '#produto' }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hero-art plate{% if img or vid %} plate--has-image{% endif %}">
      {%- if vid -%}
        {%- comment -%}
          A foto continua obrigatoria: e o cartaz do video (primeiro quadro
          para quem tem conexao lenta) e o que aparece inteiro para quem
          pediu menos movimento no sistema. Sem foto, o cartaz e o quadro
          que a propria Shopify gerou do video.
        {%- endcomment -%}
        <div class="hero-video" data-hero-video>
          {{ vid | video_tag:
               image_size: '1600x',
               autoplay: true, loop: true, muted: true, controls: false,
               class: 'plate-img plate-video' }}
          {%- assign still = img | default: vid.preview_image -%}
          {%- if still -%}
            {{ still | image_url: width: 1600 | image_tag:
                 loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 52vw, 100vw',
                 widths: '600,900,1200,1600', class: 'plate-img plate-still', alt: img.alt | default: section.settings.heading }}
          {%- endif -%}
        </div>
      {%- elsif img -%}
        {{ img | image_url: width: 1600 | image_tag:
             loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 52vw, 100vw',
             widths: '600,900,1200,1600', class: 'plate-img', alt: img.alt | default: section.settings.heading }}
      {%- else -%}
        <div class="note">
          <span>{{ section.settings.slot_id }}</span>
          <span>{{ section.settings.slot_brief }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TOOLA hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Linha de apoio",
      "default": "TOOLA ONE · Bolsa porta-ferramentas em couro certificado LWG" },
    { "type": "html", "id": "heading", "label": "Título",
      "info": "Use <br> para quebrar linha e <em> para o itálico em cor de areia.",
      "default": "Tudo o que sua mão procura.<br><em>Onde ela procura.</em>" },
    { "type": "textarea", "id": "lede", "label": "Texto de apoio",
      "default": "Criada para profissionais que transformam imagens com as próprias mãos. Cabeleireiros, barbeiros e maquiadores. Ferramentas organizadas, ao alcance, durante todo o atendimento." },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "video", "id": "video", "label": "Vídeo",
      "info": "Substitui a foto. Roda sozinho, em loop e sem som. A foto acima vira o cartaz e e o que aparece para quem pediu menos movimento no sistema." },
    { "type": "header", "content": "Enquanto não há foto" },
    { "type": "text", "id": "slot_id", "label": "Código do slot", "default": "Foto 01" },
    { "type": "text", "id": "slot_brief", "label": "Briefing da foto",
      "default": "Hairstylist em atendimento · luz natural lateral · plano médio" },
    { "type": "header", "content": "Botões" },
    { "type": "text", "id": "cta1_label", "label": "Botão principal", "default": "Escolher minha cor" },
    { "type": "url", "id": "cta1_url", "label": "Link do botão principal" },
    { "type": "text", "id": "cta2_label", "label": "Botão secundário", "default": "Ver o produto" },
    { "type": "url", "id": "cta2_url", "label": "Link do botão secundário" }
  ],
  "presets": [{ "name": "TOOLA hero" }]
}
{% endschema %}
